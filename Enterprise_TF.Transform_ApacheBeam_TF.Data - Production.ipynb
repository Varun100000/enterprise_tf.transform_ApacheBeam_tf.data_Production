   "source": [
    "#### Demonstrate Serving (Transformation Consistency)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 28,
   "id": "aa30c914-9a00-4fa8-8f2d-13a448b45942",
   "metadata": {},
   "outputs": [],
   "source": [
    "def demonstrate_serving():\n",
    "    print(\"\\n\" + \"=\"*70)\n",
    "    print(\"STEP 7: Demonstrating Transform Consistency\")\n",
    "    print(\"=\"*70)\n",
    "    \n",
    "    # Load saved transform function\n",
    "    tf_transform_output = tft.TFTransformOutput(TRANSFORM_DIR)\n",
    "    print(\"\\n✓ Loaded saved transform function (with all learned statistics)\")\n",
    "    \n",
    "    # Load model\n",
    "    model = tf.keras.models.load_model(os.path.join(MODEL_DIR, 'model'))\n",
    "    print(\"✓ Loaded trained model\")\n",
    "    \n",
    "    # Raw input (as from user)\n",
    "    raw_input = {\n",
    "        'transaction_id': [9999],\n",
    "        'product_category': ['Electronics'],\n",
    "        'price': [299.99],\n",
    "        'quantity': [2],\n",
    "        'customer_city': ['Chicago'],\n",
    "        'customer_age': [35],\n",
    "        'discount_applied': [1],\n",
    "        'target_purchased': [0]\n",
    "    }\n",
    "    \n",
    "    print(\"\\n\" + \"=\"*70)\n",
    "    print(\"TRANSFORMATION CONSISTENCY DEMO\")\n",
    "    print(\"=\"*70)\n",
    "    print(\"\\n→ Raw input:\")\n",
    "    for k, v in raw_input.items():\n",
    "        if k != 'target_purchased':\n",
    "            print(f\"  {k}: {v[0]}\")\n",
    "    \n",
    "    # Convert to tensors\n",
    "    raw_tensors = {\n",
    "        k: tf.constant(\n",
    "            v,\n",
    "            dtype=tf.int64 if k in ['transaction_id', 'quantity', 'customer_age', \n",
    "                                     'discount_applied', 'target_purchased']\n",
    "            else (tf.float32 if k == 'price' else tf.string)\n",
    "        )\n",
    "        for k, v in raw_input.items()\n",
    "    }\n",
    "    \n",
    "    # Apply SAME transformations as training\n",
    "    print(\"\\n→ Applying saved transformations...\")\n",
    "    transformed = tf_transform_output.transform_raw_features(raw_tensors)\n",
    "    \n",
    "    print(\"\\n✓ Transformed features (using saved statistics):\")\n",
    "    for k, v in transformed.items():\n",
    "        if k not in ['target_purchased', 'transaction_id']:\n",
    "            print(f\"  {k}: {v.numpy()[0]}\")\n",
    "    \n",
    "    # Predict\n",
    "    model_input = {k: v for k, v in transformed.items() \n",
    "                   if k not in ['target_purchased', 'transaction_id']}\n",
    "    \n",
    "    pred = model.predict(model_input, verbose=0)\n",
    "    print(f\"\\n✓ Prediction: {pred[0][0]:.4f} (Purchase probability: {pred[0][0]*100:.1f}%)\")\n",
    "    \n",
    "    print(\"\\n\" + \"=\"*70)\n",
    "    print(\"KEY INSIGHT: Transform Consistency Guaranteed!\")\n",
    "    print(\"=\"*70)\n",
    "    print(\"\"\"\n",
    "The transformations during serving use the EXACT same statistics\n",
    "learned during training. This is automatic - no code duplication!\n",
    " \n",
    "Training: tf.transform learns vocab, mean, std, boundaries → saves them\n",
    "Serving:  Loads saved statistics → applies identical transformations\n",
    " \n",
    "This eliminates training-serving skew!\n",
    "    \"\"\")"
   ]
  },

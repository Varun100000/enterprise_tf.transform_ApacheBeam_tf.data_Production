   "source": [
    "# Alternative: Using feature_spec (simpler approach)\n",
    "def get_raw_metadata_from_feature_spec():\n",
    "    \"\"\"\n",
    "    Simpler way to define raw data schema using TensorFlow feature specs\n",
    "    \"\"\"\n",
    "    feature_spec = {\n",
    "        'transaction_id': tf.io.FixedLenFeature([], tf.int64),\n",
    "        'product_category': tf.io.FixedLenFeature([], tf.string),\n",
    "        'price': tf.io.FixedLenFeature([], tf.float32),\n",
    "        'quantity': tf.io.FixedLenFeature([], tf.int64),\n",
    "        'customer_city': tf.io.FixedLenFeature([], tf.string),\n",
    "        'customer_age': tf.io.FixedLenFeature([], tf.int64),\n",
    "        'discount_applied': tf.io.FixedLenFeature([], tf.int64),\n",
    "        'target_purchased': tf.io.FixedLenFeature([], tf.int64),\n",
    "    }\n",
    "    return dataset_metadata.DatasetMetadata(\n",
    "        schema_utils.schema_from_feature_spec(feature_spec)\n",
    "    )"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "74afb39a-6945-4cbd-9224-45184110c7c4",
   "metadata": {},
   "source": [
    "#### Define Preprocessing Function\n",
    "\n",
    "zoom in below image"
   ]
  },
  {
   "attachments": {
    "106c26d6-8c3f-4997-a40e-1716a96806da.png": {
     "image/png": ""
    }
   },
   "cell_type": "markdown",
   "id": "a2319f83-8a9d-4471-85f3-df64dcaa2feb",
   "metadata": {},
   "source": [
    "![mermaid-diagram.png](attachment:106c26d6-8c3f-4997-a40e-1716a96806da.png)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 22,
   "id": "9bd12354-15a9-416d-8511-dc38958a8afd",
   "metadata": {},
   "outputs": [],
   "source": [
    "# THIS WILL BE USED INSIDE BEAM PIPELINE\n",
    "import tensorflow_transform as tft\n",
    "def preprocessing_fn(inputs):\n",
    "    \"\"\"\n",
    "    tf.transform preprocessing function\n",
    "    Learns: vocabulary, mean, std dev, bucketization boundaries\n",
    "    \"\"\"\n",
    "    import tensorflow_transform as tft  # <- ADD THIS LINE\n",
    "    import tensorflow as tf              # <- ADD THIS LINE\n",
    "    \n",
    "    print(\"\\nDefining preprocessing transformations...\")\n",
    "    outputs = {}\n",
    "    \n",
    "    # VOCABULARY LEARNING - Categorical features\n",
    "    print(\"→ Learning vocabularies...\")\n",
    "    outputs['product_category_integerized'] = tft.compute_and_apply_vocabulary(\n",
    "        inputs['product_category'],\n",
    "        vocab_filename='product_category_vocab'\n",
    "    ) # vocabulary mapping (string → integer ID) , not one hot encoding\n",
    "    \n",
    "    outputs['customer_city_integerized'] = tft.compute_and_apply_vocabulary(\n",
    "        inputs['customer_city'],\n",
    "        vocab_filename='customer_city_vocab'\n",
    "    )  # vocabulary mapping (string → integer ID) , not one hot encoding\n",
    "    \n",
    "    # MEAN & STD DEV - Normalization\n",
    "    print(\"→ Computing mean & std dev...\")\n",
    "    price_mean = tft.mean(inputs['price']) # by default always calculates global mean for all rows\n",
    "    price_std = tft.var(inputs['price'], reduce_instance_dims=True) ** 0.5 # reduce dimension is basically saying Give me ONE number for the whole dataset\n",
    "    outputs['price_normalized'] = (inputs['price'] - price_mean) / price_std\n",
    "    \n",
    "    age_float = tf.cast(inputs['customer_age'], tf.float32)\n",
    "    age_mean = tft.mean(age_float)\n",
    "    age_std = tft.var(age_float, reduce_instance_dims=True) ** 0.5\n",
    "    outputs['customer_age_normalized'] = (age_float - age_mean) / age_std\n",
    "    \n",
    "    # BUCKETIZATION - Boundary estimation\n",
    "    print(\"→ Estimating bucketization boundaries...\")\n",
    "    outputs['price_bucketized'] = tft.bucketize(\n",
    "        inputs['price'],\n",
    "        num_buckets=5, # buckets are created based on quantiles (approximate quantiles) -Each bucket has ~equal number of data points\n",
    "        epsilon=0.01 #  allowed error in quantile estimation 0.01 means 1% approximation error allowed\n",
    "    )\n",
    "    \n",
    "    outputs['age_bucketized'] = tft.bucketize(\n",
    "        age_float,\n",
    "        num_buckets=4,\n",
    "        epsilon=0.01\n",
    "    )\n",
    "    \n",
    "    # Feature engineering\n",
    "    quantity_float = tf.cast(inputs['quantity'], tf.float32)\n",
    "    total_amount = inputs['price'] * quantity_float\n",
    "    total_mean = tft.mean(total_amount)\n",
    "    total_std = tft.var(total_amount, reduce_instance_dims=True) ** 0.5\n",
    "    outputs['total_amount_normalized'] = (total_amount - total_mean) / total_std\n",
    "    \n",
    "    # Pass-through\n",
    "    outputs['quantity'] = inputs['quantity']\n",
    "    outputs['discount_applied'] = inputs['discount_applied']\n",
    "    outputs['target_purchased'] = inputs['target_purchased']\n",
    "    outputs['transaction_id'] = inputs['transaction_id']\n",
    "    \n",
    "    print(\"✓ Preprocessing function ready\")\n",
    "    return outputs"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "5fd0835a-fe09-4369-ac47-2102d528e1b1",
   "metadata": {},
   "source": [
    "####  Run tf.transform with Apache Beam"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 23,
   "id": "3459a4c6-8e16-4aca-98fc-75764728c749",
   "metadata": {},
   "outputs": [],
   "source": [
    "def parse_csv(line):\n",
    "    \"\"\"Parse CSV line to dict\"\"\"\n",
    "    fields = line.split(',')\n",
    "    return {\n",
    "        'transaction_id': int(fields[0]),\n",
    "        'product_category': fields[1],\n",
    "        'price': float(fields[2]),\n",
    "        'quantity': int(fields[3]),\n",
    "        'customer_city': fields[4],\n",
    "        'customer_age': int(fields[5]),\n",
    "        'discount_applied': int(fields[6]),\n",
    "        'target_purchased': int(fields[7])\n",
    "    }\n",
    " \n",
    "def run_transform(csv_path):\n",
    "    print(\"\\n\" + \"=\"*70)\n",
    "    print(\"STEP 3: Running tf.transform with Apache Beam\")\n",
    "    print(\"=\"*70)\n",
    "    \n",
    "    # Get raw data metadata (schema)\n",
    "    raw_metadata = get_raw_metadata_from_feature_spec()\n",
    "    \n",
    "    print(\"\\n✓ Raw data schema loaded\")\n",
    "    \n",
    "    # Apache Beam options\n",
    "    options = PipelineOptions(\n",
    "        runner='DirectRunner', # USING DIRECT RUNNER LOCAL LAPTOP - IDEALLY SHOULD BE DATA FLOW - FOR MUCH LARGER FILES\n",
    "        direct_num_workers=2,\n",
    "        direct_running_mode='multi_processing'\n",
    "    )\n",
    "    \n",
    "    print(\"✓ Apache Beam configured (2 workers, multi-processing)\")\n",
    "    \n",
    "    with beam.Pipeline(options=options) as pipeline:\n",
    "        with tft_beam.Context(temp_dir=os.path.join(TRANSFORM_DIR, 'tmp')):\n",
    "            \n",
    "            # Read CSV\n",
    "            raw_data = (\n",
    "                pipeline\n",
    "                | 'ReadCSV' >> beam.io.ReadFromText(csv_path, skip_header_lines=1)\n",
    "                | 'ParseCSV' >> beam.Map(parse_csv)\n",
    "            )\n",
    "            \n",
    "            print(\"\\n→ Analyzing & transforming data...\")\n",
    "            \n",
    "            # Apply tf.transform\n",
    "            transformed_dataset, transform_fn = (\n",
    "                (raw_data, raw_metadata)\n",
    "                | 'AnalyzeAndTransform' >> tft_beam.AnalyzeAndTransformDataset(\n",
    "                    preprocessing_fn\n",
    "                )\n",
    "            )\n",
    "            \n",
    "            transformed_data, transformed_metadata = transformed_dataset\n",
    "            \n",
    "            # Write TFRecords\n",
    "            print(f\"\\n→ Writing {NUM_SHARDS} TFRecord shards...\")\n",
    "            _ = (\n",
    "                transformed_data\n",
    "                | 'WriteTFRecord' >> beam.io.tfrecordio.WriteToTFRecord( # WRITING THIS TO TFRECORD SINCE ITS EFFICIENT TO LOAD AND TRAIN LATER ON\n",
    "                    file_path_prefix=os.path.join(TFRECORD_DIR, 'train'),\n",
    "                    file_name_suffix='.tfrecord',\n",
    "                    num_shards=NUM_SHARDS,\n",
    "                    coder=tft.coders.ExampleProtoCoder(transformed_metadata.schema)\n",
    "                )\n",
    "            )\n",
    "            \n",
    "            # Save transform function\n",
    "            _ = (\n",
    "                transform_fn\n",
    "                | 'WriteTransformFn' >> tft_beam.WriteTransformFn(TRANSFORM_DIR)\n",
    "            )\n",
    "    \n",
    "    print(\"\\n✓ Transform complete!\")\n",
    "    print(f\"✓ Transform function saved to: {TRANSFORM_DIR}\")\n",
    "    \n",
    "    tfrecord_files = tf.io.gfile.glob(os.path.join(TFRECORD_DIR, '*.tfrecord'))\n",
    "    print(f\"✓ Generated {len(tfrecord_files)} TFRecord shards\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "2f95193c-0b64-4eb5-830b-e7025f2ec3fe",
   "metadata": {},
   "source": [
    "#### Create tf.data Pipeline"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 24,
   "id": "13ac8781-7919-4d9b-b6b6-9ce91ccf0edb",
   "metadata": {},
   "outputs": [],
   "source": [
    "def get_transformed_feature_spec():\n",
    "    return {\n",
    "        'transaction_id': tf.io.FixedLenFeature([], tf.int64),\n",
    "        'product_category_integerized': tf.io.FixedLenFeature([], tf.int64),\n",
    "        'customer_city_integerized': tf.io.FixedLenFeature([], tf.int64),\n",
    "        'price_normalized': tf.io.FixedLenFeature([], tf.float32),\n",
    "        'customer_age_normalized': tf.io.FixedLenFeature([], tf.float32),\n",
    "        'price_bucketized': tf.io.FixedLenFeature([], tf.int64),\n",
    "        'age_bucketized': tf.io.FixedLenFeature([], tf.int64),\n",
    "        'total_amount_normalized': tf.io.FixedLenFeature([], tf.float32),\n",
    "        'quantity': tf.io.FixedLenFeature([], tf.int64),\n",
    "        'discount_applied': tf.io.FixedLenFeature([], tf.int64),\n",
    "        'target_purchased': tf.io.FixedLenFeature([], tf.int64),\n",
    "    }"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 25,
   "id": "ed9c4c7d-0e83-4b44-8f1a-23e59ce91086",
   "metadata": {},
   "outputs": [],
   "source": [
    "def create_dataset(pattern, batch_size=32):\n",
    "    print(\"\\n\" + \"=\"*70)\n",
    "    print(\"STEP 4: Creating tf.data Pipeline\")\n",
    "    print(\"=\"*70)\n",
    "    \n",
    "    files = tf.io.gfile.glob(pattern) # GLOB USED FOR USING WILD CARDS FOR TFRECORD SHARDED FILE NAMES\n",
    "    print(f\"\\n→ Found {len(files)} TFRecord files\")\n",
    "    \n",
    "    feature_spec = get_transformed_feature_spec()\n",
    "    \n",
    "    def parse_fn(serialized):\n",
    "        return tf.io.parse_single_example(serialized, feature_spec)\n",
    "    \n",
    "    # Create dataset with parallelization\n",
    "    files_ds = tf.data.Dataset.list_files(pattern, shuffle=True, seed=42)\n",
    "    \n",
    "    dataset = files_ds.interleave( # INTERLEAVE USED FOR OPENING MULTIPLE FILE NAMES ALL AT ONCE \n",
    "        lambda x: tf.data.TFRecordDataset(x),\n",
    "        cycle_length=tf.data.AUTOTUNE,  # Parallel file reading USING MULTITHREAD AUTOTUNED\n",
    "        num_parallel_calls=tf.data.AUTOTUNE, # READING DATA FROM EACH FILE USING MULTITHREAD - AUTO TUNED\n",
    "        deterministic=False #True always yield elements in the exact same order across different runs, but leads to slower throughput\n",
    "    )\n",
    "    \n",
    "    dataset = dataset.map(parse_fn, num_parallel_calls=tf.data.AUTOTUNE)\n",
    "\n",
    "    def split_features_labels(ex):\n",
    "        label = ex.pop('target_purchased')\n",
    "        return ex, label\n",
    "    \n",
    "    dataset = dataset.map(split_features_labels, num_parallel_calls=tf.data.AUTOTUNE)\n",
    "    dataset = dataset.shuffle(1000, seed=42)\n",
    "    dataset = dataset.batch(batch_size)\n",
    "    dataset = dataset.prefetch(tf.data.AUTOTUNE)  # Overlaps preprocessing & training\n",
    "    \n",
    "    print(\"✓ Pipeline created with full parallelization:\")\n",
    "    print(f\"  - interleave: cycle_length=AUTOTUNE\")\n",
    "    print(f\"  - map: num_parallel_calls=AUTOTUNE\")\n",
    "    print(f\"  - prefetch: buffer_size=AUTOTUNE\")\n",
    "    \n",
    "    return dataset"
   ]
  },
  {

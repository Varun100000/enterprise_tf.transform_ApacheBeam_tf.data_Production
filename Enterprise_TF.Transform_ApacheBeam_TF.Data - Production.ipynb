   "outputs": [],
   "source": [
    "def generate_data(n=1000):\n",
    "    print(\"\\n\" + \"=\"*70)\n",
    "    print(\"STEP 1: Generating Sample Data\")\n",
    "    print(\"=\"*70)\n",
    "    \n",
    "    categories = ['Electronics', 'Clothing', 'Books', 'Home', 'Sports']\n",
    "    cities = ['New York', 'Los Angeles', 'Chicago', 'Houston', 'Phoenix']\n",
    "    \n",
    "    data = {\n",
    "        'transaction_id': range(1, n + 1),\n",
    "        'product_category': np.random.choice(categories, n),\n",
    "        'price': np.random.uniform(10, 500, n).round(2),\n",
    "        'quantity': np.random.randint(1, 10, n),\n",
    "        'customer_city': np.random.choice(cities, n),\n",
    "        'customer_age': np.random.randint(18, 70, n),\n",
    "        'discount_applied': np.random.choice([0, 1], n),\n",
    "        'target_purchased': np.random.choice([0, 1], n)\n",
    "    }\n",
    "    \n",
    "    df = pd.DataFrame(data)\n",
    "    csv_path = os.path.join(RAW_DATA_DIR, 'data.csv')\n",
    "    df.to_csv(csv_path, index=False)\n",
    "    \n",
    "    print(f\"✓ Generated {n} records\")\n",
    "    print(f\"✓ Saved to: {csv_path}\")\n",
    "    print(f\"\\nFirst 3 rows:\\n{df.head(3)}\")\n",
    "    \n",
    "    return csv_path"
   ]
  },
  {

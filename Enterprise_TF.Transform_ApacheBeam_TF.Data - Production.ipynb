   "source": [
    "def train_model(model, dataset):\n",
    "    print(\"\\n\" + \"=\"*70)\n",
    "    print(\"STEP 6: Training Model\")\n",
    "    print(\"=\"*70)\n",
    "    \n",
    "    history = model.fit(dataset, epochs=5, verbose=1)\n",
    "    \n",
    "    model.save(os.path.join(MODEL_DIR, 'model'))\n",
    "    print(f\"\\n✓ Model saved to: {MODEL_DIR}/model\")\n",
    "    \n",
    "    return history"
   ]

    "def build_model():\n",
    "    print(\"\\n\" + \"=\"*70)\n",
    "    print(\"STEP 5: Building Model\")\n",
    "    print(\"=\"*70)\n",
    "    \n",
    "    inputs = {\n",
    "        'product_category_integerized': tf.keras.Input(shape=(1,), dtype=tf.int64),\n",
    "        'customer_city_integerized': tf.keras.Input(shape=(1,), dtype=tf.int64),\n",
    "        'price_normalized': tf.keras.Input(shape=(1,), dtype=tf.float32),\n",
    "        'customer_age_normalized': tf.keras.Input(shape=(1,), dtype=tf.float32),\n",
    "        'price_bucketized': tf.keras.Input(shape=(1,), dtype=tf.int64),\n",
    "        'age_bucketized': tf.keras.Input(shape=(1,), dtype=tf.int64),\n",
    "        'total_amount_normalized': tf.keras.Input(shape=(1,), dtype=tf.float32),\n",
    "        'quantity': tf.keras.Input(shape=(1,), dtype=tf.int64),\n",
    "        'discount_applied': tf.keras.Input(shape=(1,), dtype=tf.int64),\n",
    "    }\n",
    "    \n",
    "    # Embeddings\n",
    "    cat_emb = tf.keras.layers.Embedding(10, 4)(inputs['product_category_integerized']) \n",
    "    # categorical integer (like 0,1,2,3...) into a dense vector of numbers\n",
    "    \n",
    "    # 0, 1, 2, 3 (just numbers) - this is the format of integerized product categories  - this is converted to below format \n",
    "    \n",
    "    # 0 → [0.2, -0.1, 0.5, 0.9]\n",
    "    # 1 → [0.7,  0.3, -0.2, 0.1]\n",
    "    # 2 → [0.4,  0.8,  0.6, -0.3]\n",
    "    # ...\n",
    "    # the numbers inside each vector is a learnable parameter\n",
    "    # making embedding matrix of dimension of size 10 x 4, where 10 is the num of unique categories and 4 is the dimension of each dense vector for \n",
    "    # each of the unique categories\n",
    "\n",
    "    # on multiplying embedding of 10 * 4 and Input containing a single integer say \"3\" ( for a row of unique category), \n",
    "    # this will output row 3 of the embedding metrics which will be of dimension 1 * 4\n",
    "    # for batch size of N, this will output a dimension of N x 1 x 4 which will be input for the flatten function below\n",
    "    \n",
    "    cat_emb = tf.keras.layers.Flatten()(cat_emb)\n",
    "    # flatten will convert the input of dimension N x 1 x 4 into N x 4\n",
    "    \n",
    "    city_emb = tf.keras.layers.Embedding(15, 4)(inputs['customer_city_integerized'])\n",
    "    city_emb = tf.keras.layers.Flatten()(city_emb)\n",
    "    \n",
    "    # Concatenate\n",
    "    concat = tf.keras.layers.Concatenate()([\n",
    "        cat_emb,\n",
    "        city_emb,\n",
    "        inputs['price_normalized'],\n",
    "        inputs['customer_age_normalized'],\n",
    "        tf.cast(inputs['price_bucketized'], tf.float32),\n",
    "        tf.cast(inputs['age_bucketized'], tf.float32),\n",
    "        inputs['total_amount_normalized'],\n",
    "        tf.cast(inputs['quantity'], tf.float32),\n",
    "        tf.cast(inputs['discount_applied'], tf.float32),\n",
    "    ])\n",
    "    \n",
    "    # Dense layers\n",
    "    x = tf.keras.layers.Dense(32, activation='relu')(concat)\n",
    "    x = tf.keras.layers.Dropout(0.3)(x)\n",
    "    x = tf.keras.layers.Dense(16, activation='relu')(x)\n",
    "    output = tf.keras.layers.Dense(1, activation='sigmoid')(x)\n",
    "    \n",
    "    model = tf.keras.Model(inputs=inputs, outputs=output)\n",
    "    model.compile(\n",
    "        optimizer='adam',\n",
    "        loss='binary_crossentropy',\n",
    "        metrics=['accuracy', tf.keras.metrics.AUC(name='auc')]\n",
    "    )\n",
    "    \n",
    "    print(\"\\n✓ Model built\")\n",
    "    return model"
   ]
  },
